RFT_PROTOCOL=sftp
RFT_HOST=sftp.example.com
RFT_PORT=22
RFT_USERNAME=my-user
RFT_PASSWORD=
RFT_PRIVATE_KEY_PATH=C:/Users/me/.ssh/id_ed25519
RFT_PRIVATE_KEY_PASSPHRASE=
RFT_USE_SSH_AGENT=false
RFT_KNOWN_HOSTS_PATH=C:/Users/me/.ssh/known_hosts
RFT_CONNECTION_TIMEOUT=10
RFT_AUTHENTICATION_TIMEOUT=10
RFT_OPERATION_TIMEOUT=30
RFT_REMOTE_PATH=.
