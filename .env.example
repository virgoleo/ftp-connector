SOURCE_PROTOCOL=sftp
SOURCE_HOST=source-sftp.example.com
SOURCE_PORT=22
SOURCE_USERNAME=source-user
SOURCE_PASSWORD=
SOURCE_PRIVATE_KEY_PATH=C:/Users/me/.ssh/id_ed25519_source
SOURCE_PRIVATE_KEY_PASSPHRASE=
SOURCE_USE_SSH_AGENT=false
SOURCE_KNOWN_HOSTS_PATH=C:/Users/me/.ssh/known_hosts
SOURCE_CONNECTION_TIMEOUT=10
SOURCE_AUTHENTICATION_TIMEOUT=10
SOURCE_OPERATION_TIMEOUT=30
SOURCE_REMOTE_PATH=.

DEST_PROTOCOL=sftp
DEST_HOST=destination-sftp.example.com
DEST_PORT=22
DEST_USERNAME=destination-user
DEST_PASSWORD=
DEST_PRIVATE_KEY_PATH=C:/Users/me/.ssh/id_ed25519_destination
DEST_PRIVATE_KEY_PASSPHRASE=
DEST_USE_SSH_AGENT=false
DEST_KNOWN_HOSTS_PATH=C:/Users/me/.ssh/known_hosts
DEST_CONNECTION_TIMEOUT=10
DEST_AUTHENTICATION_TIMEOUT=10
DEST_OPERATION_TIMEOUT=30
DEST_REMOTE_PATH=.
